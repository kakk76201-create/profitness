OPENAI_API_KEY=
BOT_TOKEN=
DATABASE_URL=sqlite:///./app.db
ALLOW_INSECURE_AUTH=0
# DEBUG_AI=1 — показывать «сырой» ответ модели в приложении и в тексте ошибки
# (удобно для отладки распознавания). На проде держите 0.
DEBUG_AI=0
# OPENAI_MODEL — можно переопределить модель (по умолчанию gpt-4o).
# OPENAI_MODEL=gpt-4o
# --- Push-уведомления (через бота) ---
# APP_TZ — часовой пояс для времени напоминаний (по умолчанию Europe/Moscow).
APP_TZ=Europe/Moscow
# ENABLE_SCHEDULER=0 полностью выключает планировщик уведомлений (по умолчанию включён,
# если задан BOT_TOKEN). Уведомления шлёт тот же BOT_TOKEN, что и для авторизации.
# ENABLE_SCHEDULER=1

# === Подписка и доступ (Этап 1) ===
# OWNER_ID — числовой Telegram ID владельца (@TYREK223). У него вечный премиум,
# и только он может выполнять /givepro и /revokepro. Как узнать id — см. README.
OWNER_ID=
# Цены тарифов в РУБЛЯХ (единственная валюта; НЕ хардкод — меняются здесь).
# 0 у тарифа убирает его с витрины: продавать тариф без цены нечем.
PRICE_MONTHLY_RUB=499
PRICE_YEARLY_RUB=3990
PRICE_LIFETIME_RUB=7990
# Длительность подписок в днях (lifetime — бессрочно).
SUBSCRIPTION_MONTHLY_DAYS=30
SUBSCRIPTION_YEARLY_DAYS=365
# Сколько бесплатных сканирований еды в сутки для free-пользователя.
FREE_SCAN_LIMIT=3
# Секрет вебхука Telegram — случайная строка; та же передаётся в setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Username бота без "@" (для ссылок), напр. my_calorie_ai_bot.
BOT_USERNAME=
# --- Tribute (второй способ оплаты) — заполняется по инструкции TRIBUTE.md ---
# Секрет для проверки подлинности вебхука Tribute.
TRIBUTE_WEBHOOK_SECRET=
# Ссылка на оплату Tribute (создаётся в Tribute). Пусто — кнопка Tribute скрыта.
TRIBUTE_URL=

# === Оплата картой в рублях ===
# Кто принимает деньги:
#   auto          — по заданным ключам: ЮKassa, иначе CloudPayments, иначе none;
#   cloudpayments — виджет CloudPayments;
#   yookassa      — ЮKassa;
#   none          — приём карт не подключён: цена и кнопка видны (это нужно для
#                   модерации ЮKassa, которую проходят ДО выдачи ключей), но при
#                   нажатии приложение честно пишет «оплата подключается».
PAYMENT_PROVIDER=auto
# --- CloudPayments ---
# Public ID сайта (можно светить на фронте).
CLOUDPAYMENTS_PUBLIC_ID=
# API Secret («пароль для API») — СЕКРЕТ, им же проверяется подпись вебхука.
CLOUDPAYMENTS_API_SECRET=
# Валюта списания (по умолчанию RUB). Менять не нужно: цены задаются в рублях.
CLOUDPAYMENTS_CURRENCY=RUB
# --- ЮKassa (API v3) ---
# Идентификатор магазина и секретный ключ из личного кабинета ЮKassa.
# Пока оба пусты — интеграция выключена (маршрут создания платежа отвечает 503).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет в адресе вебхука (уведомления ЮKassa не подписаны). Любая случайная
# строка 32+ символов; адрес в кабинете ЮKassa:
#   https://<домен>/payment/yookassa/webhook/<YOOKASSA_WEBHOOK_SECRET>
# В проде без секрета уведомления НЕ обрабатываются.
YOOKASSA_WEBHOOK_SECRET=
# Куда вернуть плательщика из браузера после оплаты. Пусто — берётся
# MINI_APP_URL, иначе https://t.me/<BOT_USERNAME>.
YOOKASSA_RETURN_URL=

# === Реквизиты продавца (показываются на странице оплаты) ===
# Их наличие проверяет модерация платёжного сервиса: покупатель должен видеть,
# кому платит, и иметь ссылки на оферту и политику. Пустые — не показываются.
LEGAL_SELLER=
LEGAL_INN=
SUPPORT_CONTACT=
OFFER_URL=
PRIVACY_URL=
